# used AI because I can gaf about learning i3 config (i love i3 tho)
wireless _first_ {
    format_up = "  %essid %quality"
    format_down = "  down"
}

ethernet _first_ {
    format_up = "  %ip"
    format_down = ""
}


tztime local {
    format = "  %I:%M %p - %a %b %d  "
}

battery all {
    format = "  %status %percentage  "
    format_down = "no battery"
    status_chr = "C"
    status_bat = "B"
    status_unk = "?"
    status_full = "F"
    low_threshold = 20
}

order += "tztime local"
order += "battery all"
order += "wireless _first_"
order += "ethernet _first_"
